# ============================================================================
#  Traccoon — Umgebungskonfiguration (Vorlage)
#  Every credential, hostname and path is managed HERE and nowhere else.
#  Copy this file to `.env` and replace the placeholders. `.env` is gitignored and
#  NEVER belongs in the repository.
# ============================================================================

# --- Datenbank (Pflicht) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=traccoon

# --- Auth / Krypto (Pflicht) ---
# JWT-Secret: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
# Fernet-Key (44 Zeichen base64). Leer = Klartext (nur Dev!). Erzeugen:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
# Interner Dienst-zu-Dienst-Token (backend ↔ deployer/shotter): openssl rand -hex 24
INTERNAL_TOKEN=change-me-internal-token

JWT_EXPIRE_MINUTES=720
ALLOWED_ORIGINS=*
BACKEND_PORT=8800
FRONTEND_PORT=8080

# --- Reverse Proxy (Traefik) ---
# The public hostname Traccoon is reachable under.
TRACCOON_HOST=traccoon.example.com

# --- Host-Pfade (Pflicht, an die eigene Installation anpassen) ---
# The root the docker stacks live under (mounted into the deployer).
DOCKER_STACKS_DIR=/path/to/docker/stacks
# Verzeichnis dieses Stacks.
SELF_STACK_DIR=/path/to/docker/stacks/traccoon
# Host-Pfad des Agent-Workspace (…/data/workspace dieses Stacks).
WORKSPACE_HOST_PATH=/path/to/docker/stacks/traccoon/data/workspace

# --- Testumgebung ---
TESTENV_HOST=localhost
TESTENV_PORT_RANGE=8100-8199

# --- Bootstrap admin (only on the very first start, when 0 users exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Dev: Tabellen per create_all beim Start anlegen (Prod: Alembic, dann false) ---
DEV_CREATE_ALL=true

# --- Public base URL (for invitation links in e-mails), e.g. https://traccoon.example.com ---
APP_BASE_URL=

# --- Optional: SMTP for outgoing mail (project invitations). Without a host: log only, no sending.
# Configurable through the admin UI (Administration → E-mail) as well — values set there override ENV.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# --- Optional: Worker / Modelle / Gateways ---
# DEFAULT_CLAUDE_MODEL=claude-sonnet-4-5
# DEFAULT_CODEX_MODEL=gpt-5
# WORKER_CONCURRENCY=3
# MCP_GATEWAY_URL=
# MCP_GATEWAY_TOKEN=
# MCPJUNGLE_BASE=http://mcpjungle:8080

# --- Optional: Telegram-Bot ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# TELEGRAM_OWNER_CHAT=

# --- Optional: Sprachnachrichten (lokaler Whisper-Container, siehe compose.yml Dienst `whisper`) ---
# WHISPER_URL=http://whisper:9000
# WHISPER_MODEL=small
# TELEGRAM_VOICE_MAX_SECONDS=600

# --- Optional: Shotter (Screenshots) ---
# SHOT_BASE_URL=
# SHOT_LOGIN_EMAIL=
# SHOT_LOGIN_PASSWORD=

# ============================================================================
#  Only for the operator script scripts/provision_mcp.py (not used by the stack)
# ============================================================================
# PG_DSN=postgresql://<user>:<pw>@<host>:<port>/<db>
# MCPJUNGLE_GROUPS_DIR=/path/to/docker/stacks/mcp/groups
