# The filmer — the renderer of the end-of-day film, as a sidecar of its own.
#
# Why not inside `shotter`: that is a 1.5 GB Playwright image with a resident Chromium, built
# from a different context and holding credentials. Why not through `docker run` from the
# scheduler: the backend container deliberately has **no** docker socket.
#
# And why without a `package.json`: layers 0 and 1 under `src/components/office/` import not a
# single package (verified — only `useTheme`, `useOfficeFeed` and `api.ts` see React, and nobody
# loads those here). So there is no `npm install`, no lockfile and no build step; the image is
# the base image plus a few hundred kilobytes of source.
#
# `--experimental-strip-types` lets Node load the `.ts` files directly: the types are stripped,
# not compiled. That is exactly why the pixel contract holds "nothing that does not survive the
# stripping of the types" (rule 5) — here the rule is redeemed.
FROM node:22-alpine

WORKDIR /app

COPY src/components/office/ ./src/components/office/
COPY tools/film/ ./tools/film/

ENV FILMER_PORT=8710
EXPOSE 8710

CMD ["node", "--experimental-strip-types", "tools/film/server.mjs"]
